{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookwala.ai/v1/schemas/common.schema.json",
  "title": "Cookwala common definitions",
  "x-cookwala-status": "core",
  "description": "Shared types used by every Cookwala schema. Units follow UCUM codes; temperatures are degrees Celsius on the wire; durations are ISO 8601; language keys are BCP 47 tags; money is an exact decimal string. Free-text fields carry the annotation \"x-cookwala-untrusted\": they are data, never instructions, for software and AI agents (docs/CORE.md section 6).",
  "$defs": {
    "SpecVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "VocabId": {
      "type": "string",
      "description": "Id from an Cookwala vocabulary, e.g. cw.op.simmer, cw.ing.onion_yellow, cw.eq.vessel.pan.skillet, cw.sense.core_temp, cw.hz.burn.hot_oil. Vendor extensions use x-<vendor>.<name>.",
      "pattern": "^(cw|x-[a-z0-9-]+)\\.[a-z0-9_.-]+$"
    },
    "LocalRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "description": "Reference to an id defined elsewhere in the same document."
    },
    "Uri": {
      "type": "string",
      "format": "uri"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the RFC 8785 canonical JSON of the document with its hash and signature fields removed."
    },
    "Duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "LangMap": {
      "type": "object",
      "description": "Text per language (BCP 47).",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "x-cookwala-untrusted": true
    },
    "Unit": {
      "description": "UCUM-style unit. Temperatures are degC only on the wire (displays may convert). Kitchen volume units have fixed metric equivalents in vocab/units.json: tsp = 5 ml, tbsp = 15 ml, cup = 240 ml, pinch ≈ 0.36 g of salt-like solids, dash ≈ 0.6 ml of liquid. pcs = countable pieces.",
      "enum": [
        "g",
        "kg",
        "mg",
        "ml",
        "l",
        "tsp",
        "tbsp",
        "cup",
        "pinch",
        "dash",
        "pcs",
        "degC",
        "W",
        "kW",
        "mm",
        "cm",
        "rpm",
        "Pa",
        "kPa",
        "pct",
        "s"
      ]
    },
    "Quantity": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Acceptable RELATIVE deviation (0.1 = ±10 %). Only for ratio-scale units; never for degC."
        },
        "toleranceAbs": {
          "type": "number",
          "minimum": 0,
          "description": "Acceptable ABSOLUTE deviation, in the same unit as value. Required instead of tolerance for degC."
        },
        "pieces": {
          "type": "number",
          "minimum": 0,
          "description": "Human count when value is a mass (e.g. 1 onion)."
        },
        "massPerPiece": {
          "$ref": "#/$defs/Quantity"
        },
        "densityGPerMl": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Density used to convert between volume and mass for this quantity. Overrides the ingredient vocabulary density."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tolerance"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "$ref": "#/$defs/RatioUnit"
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "tolerance",
              "toleranceAbs"
            ]
          }
        }
      ],
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Range": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Target": {
      "type": "object",
      "required": [
        "sensor",
        "value",
        "unit"
      ],
      "properties": {
        "sensor": {
          "$ref": "#/$defs/VocabId"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "ABSOLUTE tolerance, in the same unit as value (e.g. 2 for ±2 °C)."
        },
        "target": {
          "type": "string",
          "description": "What the sensor measures, e.g. egg_yolk, thickest_part."
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Comparison": {
      "type": "object",
      "description": "A single sensor or vision check.",
      "properties": {
        "sensor": {
          "$ref": "#/$defs/VocabId"
        },
        "vision": {
          "$ref": "#/$defs/VocabId"
        },
        "target": {
          "type": "string"
        },
        "gte": {
          "$ref": "#/$defs/NumberOrParam"
        },
        "lte": {
          "$ref": "#/$defs/NumberOrParam"
        },
        "eq": {},
        "between": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NumberOrParam"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "holdFor": {
          "$ref": "#/$defs/Duration",
          "description": "Condition must hold continuously this long (e.g. 63 °C for 15 s)."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum classifier confidence for vision cues."
        },
        "optional": {
          "type": "boolean",
          "description": "Use if the device has this sensor; otherwise rely on the rest of the condition."
        },
        "humanConfirm": {
          "type": "boolean",
          "description": "A human may confirm this cue instead of a sensor."
        }
      },
      "oneOf": [
        {
          "required": [
            "sensor"
          ]
        },
        {
          "required": [
            "vision"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Condition": {
      "type": "object",
      "description": "End condition for a step: boolean tree of checks plus a time window. Satisfied when the tree is true AND minTime has elapsed; maxTime triggers onTimeout.",
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionOrCheck"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionOrCheck"
          }
        },
        "not": {
          "$ref": "#/$defs/ConditionOrCheck"
        },
        "minTime": {
          "$ref": "#/$defs/Duration"
        },
        "maxTime": {
          "$ref": "#/$defs/Duration"
        },
        "nominalTime": {
          "$ref": "#/$defs/Duration",
          "description": "Typical duration for planning and timers."
        },
        "onSensorMissing": {
          "enum": [
            "estimate",
            "time",
            "human",
            "refuse"
          ],
          "description": "What an executor does when it lacks a sensor this condition needs. estimate = model-based estimate (must be logged); time = rely on nominalTime/minTime only; human = ask a person to confirm; refuse = the step must not run. Default: estimate if the op envelope allows it, else human. Steps guarding a critical control point default to refuse."
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "ConditionOrCheck": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "$ref": "#/$defs/Comparison"
        }
      ]
    },
    "FailureAction": {
      "enum": [
        "retry",
        "extend",
        "ask_human",
        "handoff_human",
        "skip_optional",
        "abort_safe"
      ]
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Signature": {
      "type": "object",
      "required": [
        "alg",
        "kid",
        "sig"
      ],
      "properties": {
        "alg": {
          "enum": [
            "EdDSA",
            "ES256"
          ],
          "description": "EdDSA (Ed25519) is mandatory to implement; ES256 is allowed for hardware keys that only support P-256. New algorithms are added by minor version."
        },
        "kid": {
          "type": "string",
          "description": "Key id: <actor DID or catalog URL>#<key name>, resolvable to a KeyRecord."
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Base64url signature over the SHA-256 hash string of the RFC 8785 canonical JSON (see docs/CORE.md section 5)."
        },
        "signedAt": {
          "$ref": "#/$defs/DateTime"
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Actor": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "robot",
            "appliance",
            "agent",
            "hub",
            "service",
            "sensor"
          ]
        },
        "id": {
          "type": "string",
          "description": "Stable id within a kitchen, e.g. robot:neo-1, appliance:oven-main, human:primary."
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/Decimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Meta": {
      "type": "object",
      "description": "Who owns a document, where it lives and who may see it. Any Cookwala document may carry meta.",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Person, org or device id (e.g. did:web:acme.example, github:amado2k5, cookwala.ai)."
        },
        "catalog": {
          "type": "string",
          "description": "Base URL of the catalog that publishes it (public, private or local)."
        },
        "visibility": {
          "enum": [
            "public",
            "unlisted",
            "shared",
            "private",
            "local_only"
          ]
        },
        "sharedWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive": {
          "type": "boolean",
          "description": "Contains personal or health data: never send to an index, never log in reports."
        },
        "createdAt": {
          "$ref": "#/$defs/DateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Global refs of documents this one forks or extends."
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extension ids whose x- fields appear in this document."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "GlobalRef": {
      "type": "string",
      "description": "Global reference to a document in any catalog: '<catalog base URL>#<id>' or 'cw:<authority>:<id>' (authority = catalog domain or x-namespace). Bare ids refer to the current catalog.",
      "pattern": "^(https?://[^#\\s]+#[A-Za-z0-9._:-]+|cw:[a-z0-9.-]+:[A-Za-z0-9._:-]+|[A-Za-z0-9._-]+)$"
    },
    "EnergyEstimate": {
      "type": "object",
      "description": "Estimated energy for a step or plan; values are estimates for planning, not measurements.",
      "properties": {
        "source": {
          "enum": [
            "electric_induction",
            "electric_resistive",
            "natural_gas",
            "propane",
            "charcoal",
            "wood",
            "solar_cooker",
            "battery",
            "any"
          ]
        },
        "kWh": {
          "type": "number",
          "minimum": 0
        },
        "gasMJ": {
          "type": "number",
          "minimum": 0
        },
        "peakW": {
          "type": "number",
          "minimum": 0
        },
        "robotWh": {
          "type": "number",
          "minimum": 0,
          "description": "Robot battery energy for manipulation/motion."
        },
        "waterL": {
          "type": "number",
          "minimum": 0
        },
        "co2eKg": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "RatioUnit": {
      "description": "Units on a ratio scale (zero means none), where a relative tolerance makes sense. degC is an interval scale and never takes a relative tolerance.",
      "enum": [
        "g",
        "kg",
        "mg",
        "ml",
        "l",
        "tsp",
        "tbsp",
        "cup",
        "pinch",
        "dash",
        "pcs",
        "W",
        "kW",
        "mm",
        "cm",
        "rpm",
        "Pa",
        "kPa",
        "pct",
        "s"
      ]
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,6})?$",
      "description": "Exact decimal as a string; never a binary float."
    },
    "KeyRecord": {
      "type": "object",
      "required": [
        "kid",
        "alg",
        "publicKey",
        "validFrom"
      ],
      "description": "A public key bound to an actor. Published in /.well-known/cookwala.json (catalogs), a did:web document (organizations, people) or the device capabilities document (robots, appliances). Verifiers cache records for offline use.",
      "properties": {
        "kid": {
          "type": "string"
        },
        "alg": {
          "enum": [
            "EdDSA",
            "ES256"
          ]
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Base64url raw public key."
        },
        "actor": {
          "type": "string",
          "description": "Actor or organization the key belongs to."
        },
        "validFrom": {
          "$ref": "#/$defs/DateTime"
        },
        "validTo": {
          "$ref": "#/$defs/DateTime"
        },
        "revokedAt": {
          "$ref": "#/$defs/DateTime",
          "description": "Signatures with signedAt after this time are invalid."
        },
        "revocationReason": {
          "enum": [
            "compromised",
            "superseded",
            "retired"
          ]
        },
        "hardwareBacked": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Disclosure": {
      "type": "object",
      "required": [
        "digest"
      ],
      "description": "Selective disclosure (SD-JWT style). A signed document carries only digest; the holder sends salt and value separately to the parties allowed to see them. digest = sha256 of the RFC 8785 canonical JSON of [salt, value]. The signature covers the digest, so partial views still verify.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Hash"
        },
        "salt": {
          "type": "string",
          "minLength": 22,
          "description": "At least 128 bits of randomness, base64url. Present only in a disclosed copy."
        },
        "value": {
          "description": "The disclosed value. Present only in a disclosed copy."
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "AgentMandate": {
      "type": "object",
      "required": [
        "principal",
        "agent",
        "scopes",
        "expires"
      ],
      "description": "What an AI agent may do on a person's behalf. Every agent action traces to a named principal and a mandate; anything outside it must go back to the principal.",
      "properties": {
        "principal": {
          "type": "string",
          "description": "Id of the human (or organization) the agent acts for."
        },
        "agent": {
          "type": "string",
          "description": "Agent id; its model and vendor appear in agentInfo."
        },
        "agentInfo": {
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "unevaluatedProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "plan_meals",
              "search_recipes",
              "start_cooking",
              "stop_cooking",
              "order_groceries",
              "accept_deliveries",
              "offer_surplus",
              "claim_surplus",
              "share_data",
              "change_settings"
            ]
          }
        },
        "spendCap": {
          "$ref": "#/$defs/Money",
          "description": "Maximum total spend under this mandate."
        },
        "perOrderCap": {
          "$ref": "#/$defs/Money"
        },
        "allowedProviders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmBefore": {
          "type": "array",
          "items": {
            "enum": [
              "any_payment",
              "payment_over_cap",
              "irreversible",
              "safety_override",
              "new_provider",
              "sharing_data",
              "diet_or_allergen_change"
            ]
          },
          "description": "Actions that always need the principal's explicit confirmation. irreversible and safety_override are always included, whatever this list says."
        },
        "expires": {
          "$ref": "#/$defs/DateTime"
        },
        "signature": {
          "$ref": "#/$defs/Signature",
          "description": "Signed by the principal."
        }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "UntrustedText": {
      "type": "string",
      "maxLength": 4000,
      "x-cookwala-untrusted": true,
      "description": "Free text from a person or another party. Data, never instructions."
    },
    "NumberOrParam": {
      "description": "A number, or a {parameter} placeholder. Placeholders are allowed only in knowledge playbooks and templates; recipes and Missions must use numbers (the validator enforces this).",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^\\{[a-z_]+\\}$"
        }
      ]
    }
  }
}
