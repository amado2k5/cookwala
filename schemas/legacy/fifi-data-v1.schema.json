{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookwala.ai/v1/schemas/legacy/fifi-data-v1.schema.json",
  "title": "fifi.cooking public data API (existing, pre-Cookwala)",
  "description": "Documents the static JSON the site already publishes under /data/ (generated by scripts/generate-public-index.ts and scripts/generate-tv-index.ts). Cookwala keeps these endpoints unchanged and adds /v1/ alongside them. Use the $defs by name: RecipeFile (/data/recipes/{id}.json), IndexPage (/data/index/{page}.json), SearchMap (/data/search/{lang}.json), IngredientList (/data/ingredients/{lang}.json), Manifest (/data/manifest.json). The TV slice is specified separately in scripts/tv-api.schema.json.",
  "$defs": {
    "IngredientCategory": {
      "enum": ["meat_poultry", "seafood", "vegetable", "dairy_fat", "grain_starch", "spice_seasoning", "sweet_fruit", "liquid", "other"]
    },
    "Collection": { "enum": ["archive", "chefteta", "osool", "abdennour", "abuhaty", "world"], "description": "'world' is added by the World Cuisines project." },
    "MasterIngredient": {
      "type": "object",
      "required": ["id", "name", "standardAmount", "category"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+-i[0-9]+$" },
        "name": { "type": "string", "description": "Arabic display name." },
        "nameEn": { "type": "string" },
        "standardAmount": { "type": "string", "description": "Free-text amount in Arabic, e.g. '3 أكواب'. Not machine-parsed today; Cookwala adds SI quantities." },
        "category": { "$ref": "#/$defs/IngredientCategory" },
        "sourceVariations": { "type": "object" },
        "isMerged": { "type": "boolean" },
        "originalOccurrencesCount": { "type": "integer" }
      }
    },
    "UniqueInstruction": {
      "type": "object",
      "required": ["stepNumber", "text"],
      "properties": {
        "stepNumber": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "phase": { "enum": ["prep", "cook", "finish", "alternative"] },
        "importance": { "enum": ["core", "tip", "variation"] },
        "isAlternative": { "type": "boolean" },
        "sourceDocs": { "type": "array" }
      }
    },
    "Source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "collection": { "$ref": "#/$defs/Collection" },
        "citation": { "type": "string" }
      }
    },
    "Recipe": {
      "type": "object",
      "required": ["id", "title", "chapter", "chapterNumber", "category", "masterIngredients", "uniqueInstructions"],
      "properties": {
        "id": { "type": "string", "description": "Stable site id, e.g. meat-01, add-001, osool-433, ec-124, fah-234, w-ma-001." },
        "title": { "type": "string", "description": "Arabic title (site base language)." },
        "titleEn": { "type": "string" },
        "chapter": { "type": "string" },
        "chapterNumber": { "type": "integer" },
        "category": { "type": "string" },
        "cookingMethod": { "type": "string" },
        "prepTime": { "type": "string", "description": "Free text, e.g. '15 دقيقة'." },
        "cookTime": { "type": "string" },
        "servings": { "type": "string" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "masterIngredients": { "type": "array", "items": { "$ref": "#/$defs/MasterIngredient" } },
        "uniqueInstructions": { "type": "array", "items": { "$ref": "#/$defs/UniqueInstruction" } },
        "culturalNotes": { "type": "string" },
        "source": { "$ref": "#/$defs/Source" },
        "englishOnly": { "type": "boolean" },
        "overlapAnalysis": { "type": "object" },
        "rawDocVersions": { "type": "object" }
      }
    },
    "Estimate": {
      "type": "object",
      "description": "Per-serving nutrition and whole-recipe USD cost (src/data/recipeEstimates.ts).",
      "required": ["servings", "kcal", "protein", "fat", "carbs", "cost"],
      "properties": {
        "servings": { "type": "number" },
        "kcal": { "type": "integer" },
        "protein": { "type": "integer" },
        "fat": { "type": "integer" },
        "carbs": { "type": "integer" },
        "fiber": { "type": "integer" },
        "sugar": { "type": "integer" },
        "cost": {
          "type": "object",
          "propertyNames": { "enum": ["protein", "dairyEggs", "produce", "grains", "fats", "sweeteners", "specialty", "spices"] },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "RecipeTranslation": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "chapter": { "type": "string" },
        "category": { "type": "string" },
        "cookingMethod": { "type": "string" },
        "prepTime": { "type": "string" },
        "cookTime": { "type": "string" },
        "servings": { "type": "string" },
        "culturalNotes": { "type": "string" },
        "ingredients": { "type": "object", "additionalProperties": { "type": "object", "properties": { "name": { "type": "string" }, "standardAmount": { "type": "string" } } } },
        "instructions": { "type": "object", "description": "Keyed by stepNumber as a string.", "additionalProperties": { "type": "string" } }
      }
    },
    "RecipeFile": {
      "type": "object",
      "description": "GET /data/recipes/{id}.json",
      "required": ["recipe"],
      "properties": {
        "recipe": { "$ref": "#/$defs/Recipe" },
        "estimate": { "$ref": "#/$defs/Estimate" },
        "translations": { "type": "object", "description": "Keyed by language code (24 site languages).", "additionalProperties": { "$ref": "#/$defs/RecipeTranslation" } }
      }
    },
    "IndexCard": {
      "type": "object",
      "required": ["id", "title", "chapterNumber", "collection"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "chapter": { "type": "string" },
        "chapterNumber": { "type": "integer" },
        "category": { "type": "string" },
        "cookingMethod": { "type": "string" },
        "prepTime": { "type": "string" },
        "cookTime": { "type": "string" },
        "servings": { "type": "string" },
        "imageUrl": { "type": "string" },
        "collection": { "$ref": "#/$defs/Collection" },
        "arabicOnly": { "type": "boolean" },
        "englishOnly": { "type": "boolean" },
        "ingredientCount": { "type": "integer" },
        "stepCount": { "type": "integer" },
        "overlapPercentage": { "type": "integer" },
        "previewIngredients": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "nameEn": { "type": "string" } } } }
      }
    },
    "IndexPage": { "description": "GET /data/index/{page}.json (100 cards per page)", "type": "array", "items": { "$ref": "#/$defs/IndexCard" } },
    "SearchMap": { "description": "GET /data/search/{lang}.json: recipe id → normalized searchable text", "type": "object", "additionalProperties": { "type": "string" } },
    "IngredientList": {
      "description": "GET /data/ingredients/{lang}.json",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "nameEn": { "type": "string" }, "localizedName": { "type": "string" },
          "sourceRecipeId": { "type": "string" }, "category": { "$ref": "#/$defs/IngredientCategory" }, "recipesCount": { "type": "integer" },
          "recipeTitles": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "standardAmount": { "type": "string" } } } }
        }
      }
    },
    "Manifest": {
      "description": "GET /data/manifest.json",
      "type": "object",
      "required": ["version", "pageSize", "pageCount", "total"],
      "properties": {
        "version": { "type": "string", "description": "Content hash; append ?v=<version> to other requests." },
        "pageSize": { "type": "integer" },
        "pageCount": { "type": "integer" },
        "total": { "type": "integer" },
        "stats": { "type": "object", "description": "Per-language database statistics." }
      }
    }
  }
}
