{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookwala.ai/v1/schemas/humanitarian.schema.json",
  "title": "Cookwala Humanitarian Profile",
  "x-cookwala-status": "profile-draft",
  "description": "A minimal, strict, personal-data-free subset of Cookwala for food banks, community kitchens, school-meal and relief programs: surplus offers, claims, custody handovers with cold-chain checks, aggregate distributions, and machine-readable nutrition and food-safety rule packs. Works without robots. See docs/HUMANITARIAN-PROFILE.md. Unlike the core schemas, every object here rejects unknown properties except x- extensions, temperatures are degrees Celsius only, tolerances are absolute, and money is a decimal string.",
  "$defs": {
    "Version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$",
      "description": "Humanitarian Profile version. Readers accept any patch version of their minor version and reject other minors."
    },
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,95}$"
    },
    "OrgId": {
      "type": "string",
      "pattern": "^(did:web:[a-z0-9.-]+|gln:[0-9]{13}|org:[a-z0-9-]+\\.[a-z0-9.-]+)$",
      "description": "An ORGANIZATION, never a person: a did:web domain, a GS1 Global Location Number, or a registry-scoped id."
    },
    "Role": {
      "enum": [
        "donor",
        "food_bank",
        "community_kitchen",
        "school",
        "relief_program",
        "transporter",
        "cold_storage",
        "platform"
      ]
    },
    "DateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 with an explicit offset."
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Kg": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Mass in kilograms. The profile uses kg only."
    },
    "TempC": {
      "type": "number",
      "minimum": -60,
      "maximum": 300,
      "description": "Degrees Celsius. The profile uses Celsius only; displays may convert."
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,6})?$",
      "description": "Exact decimal, never a binary float."
    },
    "Money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Decimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Extensions": {
      "patternProperties": {
        "^x-[a-z0-9-]+$": {}
      }
    },
    "Note": {
      "type": "string",
      "maxLength": 280,
      "description": "Operational note. MUST NOT contain names, phone numbers, ids or health details of any person."
    },
    "Site": {
      "type": "object",
      "required": [
        "country",
        "admin1"
      ],
      "unevaluatedProperties": false,
      "description": "An organization's premises or an administrative area. Never a household or a person's location.",
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "admin1": {
          "type": "string",
          "maxLength": 80
        },
        "admin2": {
          "type": "string",
          "maxLength": 80
        },
        "pcode": {
          "type": "string",
          "maxLength": 20,
          "description": "OCHA common operational dataset P-code."
        },
        "gln": {
          "type": "string",
          "pattern": "^[0-9]{13}$"
        },
        "siteName": {
          "type": "string",
          "maxLength": 80,
          "description": "Name of the organization's site, e.g. 'North warehouse'."
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "$ref": "#/$defs/Extensions"
    },
    "Storage": {
      "enum": [
        "ambient",
        "chilled",
        "frozen",
        "hot_held"
      ]
    },
    "DateMark": {
      "type": "object",
      "required": [
        "kind",
        "date"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "use_by",
            "best_before",
            "cooked_on",
            "none"
          ]
        },
        "date": {
          "$ref": "#/$defs/Date"
        }
      }
    },
    "Item": {
      "type": "object",
      "required": [
        "name",
        "kg",
        "storage"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "lineId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "ingredientId": {
          "type": "string",
          "pattern": "^(cw|x-[a-z0-9-]+)\\.[a-z0-9_.-]+$"
        },
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{8,14}$"
        },
        "kg": {
          "$ref": "#/$defs/Kg"
        },
        "units": {
          "type": "integer",
          "minimum": 0
        },
        "storage": {
          "$ref": "#/$defs/Storage"
        },
        "dateMark": {
          "$ref": "#/$defs/DateMark"
        },
        "allergens": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "cereals_gluten",
              "crustaceans",
              "eggs",
              "fish",
              "peanuts",
              "soybeans",
              "milk",
              "tree_nuts",
              "sesame",
              "mustard",
              "celery",
              "lupin",
              "molluscs",
              "sulphites",
              "unknown"
            ]
          },
          "description": "Declared allergens. 'unknown' means unlabelled and triggers rule-pack checks."
        },
        "cooked": {
          "type": "boolean",
          "description": "Ready-to-eat cooked food (higher risk)."
        },
        "cookedAt": {
          "$ref": "#/$defs/DateTime"
        }
      },
      "$ref": "#/$defs/Extensions"
    },
    "TempReading": {
      "type": "object",
      "required": [
        "at",
        "tempC",
        "method"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/DateTime"
        },
        "tempC": {
          "$ref": "#/$defs/TempC"
        },
        "method": {
          "enum": [
            "probe",
            "infrared",
            "logger",
            "fridge_display",
            "not_measured"
          ]
        },
        "lineId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        }
      }
    },
    "OfferState": {
      "enum": [
        "offered",
        "claimed",
        "collected",
        "delivered",
        "distributed",
        "expired",
        "withdrawn",
        "rejected"
      ],
      "description": "Legal transitions are listed in docs/HUMANITARIAN-PROFILE.md section 5; anything else MUST be refused with 409."
    },
    "RejectReason": {
      "enum": [
        "temp_out_of_range",
        "past_use_by",
        "packaging_damaged",
        "allergen_unlabelled",
        "quantity_mismatch",
        "pests_or_contamination",
        "no_capacity",
        "no_transport",
        "arrived_late",
        "other"
      ]
    },
    "Offer": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "id",
        "donor",
        "items",
        "window",
        "site",
        "state"
      ],
      "unevaluatedProperties": false,
      "description": "A donor offers surplus food for collection.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "const": "Offer"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "donor": {
          "$ref": "#/$defs/OrgId"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "window": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "unevaluatedProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/DateTime"
            },
            "to": {
              "$ref": "#/$defs/DateTime"
            }
          }
        },
        "site": {
          "$ref": "#/$defs/Site"
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TempReading"
          },
          "description": "Storage temperatures at the donor when offered."
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "refrigerated_vehicle",
              "pallet_jack",
              "volunteers",
              "same_day"
            ]
          }
        },
        "donationProtection": {
          "type": "string",
          "maxLength": 80,
          "description": "Applicable donor-liability law, e.g. 'US Bill Emerson Act'."
        },
        "state": {
          "$ref": "#/$defs/OfferState"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Incremented on every change; used with If-Match."
        },
        "note": {
          "$ref": "#/$defs/Note"
        }
      },
      "$ref": "#/$defs/Extensions"
    },
    "Claim": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "id",
        "offer",
        "claimant",
        "lines",
        "pickupBy"
      ],
      "unevaluatedProperties": false,
      "description": "A receiving organization claims all or part of an offer.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "const": "Claim"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "offer": {
          "$ref": "#/$defs/Id"
        },
        "claimant": {
          "$ref": "#/$defs/OrgId"
        },
        "claimantRole": {
          "$ref": "#/$defs/Role"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lineId",
              "kg"
            ],
            "unevaluatedProperties": false,
            "properties": {
              "lineId": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "kg": {
                "$ref": "#/$defs/Kg"
              }
            }
          }
        },
        "pickupBy": {
          "$ref": "#/$defs/DateTime"
        },
        "transporter": {
          "$ref": "#/$defs/OrgId"
        },
        "vehicle": {
          "enum": [
            "refrigerated",
            "insulated",
            "ambient",
            "on_foot_or_bike"
          ]
        },
        "note": {
          "$ref": "#/$defs/Note"
        }
      },
      "$ref": "#/$defs/Extensions"
    },
    "Handover": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "id",
        "offer",
        "from",
        "to",
        "at",
        "readings",
        "lines",
        "outcome"
      ],
      "unevaluatedProperties": false,
      "description": "A custody transfer with a cold-chain check. One per leg (donor → transporter → food bank → kitchen).",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "const": "Handover"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "offer": {
          "$ref": "#/$defs/Id"
        },
        "claim": {
          "$ref": "#/$defs/Id"
        },
        "from": {
          "$ref": "#/$defs/OrgId"
        },
        "to": {
          "$ref": "#/$defs/OrgId"
        },
        "at": {
          "$ref": "#/$defs/DateTime"
        },
        "site": {
          "$ref": "#/$defs/Site"
        },
        "readings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/TempReading"
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lineId",
              "kgAccepted"
            ],
            "unevaluatedProperties": false,
            "properties": {
              "lineId": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "kgAccepted": {
                "$ref": "#/$defs/Kg"
              },
              "kgRejected": {
                "$ref": "#/$defs/Kg"
              },
              "reason": {
                "$ref": "#/$defs/RejectReason"
              }
            }
          }
        },
        "outcome": {
          "enum": [
            "accepted",
            "partly_accepted",
            "rejected"
          ]
        },
        "checkedBy": {
          "enum": [
            "trained_staff",
            "volunteer",
            "driver",
            "automated_logger"
          ],
          "description": "A role, never a name."
        },
        "rulePack": {
          "type": "string",
          "description": "Id@version of the rule pack applied."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "description": "Ids of rules that warned or blocked."
        },
        "note": {
          "$ref": "#/$defs/Note"
        }
      },
      "$ref": "#/$defs/Extensions"
    },
    "Distribution": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "id",
        "org",
        "site",
        "date",
        "meals"
      ],
      "unevaluatedProperties": false,
      "description": "AGGREGATE record of food served or handed out at a site on a day. No individual or household records exist in this profile.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "const": "Distribution"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "org": {
          "$ref": "#/$defs/OrgId"
        },
        "orgRole": {
          "$ref": "#/$defs/Role"
        },
        "site": {
          "$ref": "#/$defs/Site"
        },
        "date": {
          "$ref": "#/$defs/Date"
        },
        "form": {
          "enum": [
            "hot_meals",
            "food_parcels",
            "school_meals",
            "mixed"
          ]
        },
        "meals": {
          "type": "integer",
          "minimum": 0
        },
        "people": {
          "type": "object",
          "unevaluatedProperties": false,
          "description": "Counts by HXL-style groups. Any group under 10 MUST be reported as the string '<10' (small-cell suppression).",
          "properties": {
            "total": {
              "$ref": "#/$defs/Count"
            },
            "children": {
              "$ref": "#/$defs/Count"
            },
            "adults": {
              "$ref": "#/$defs/Count"
            },
            "elderly": {
              "$ref": "#/$defs/Count"
            },
            "female": {
              "$ref": "#/$defs/Count"
            },
            "male": {
              "$ref": "#/$defs/Count"
            }
          }
        },
        "kgUsed": {
          "$ref": "#/$defs/Kg"
        },
        "kgRescuedUsed": {
          "$ref": "#/$defs/Kg"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "menu": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "recipes": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "perPersonDay": {
              "$ref": "#/$defs/Nutrients"
            },
            "perMeal": {
              "$ref": "#/$defs/Nutrients"
            }
          }
        },
        "cost": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "food": {
              "$ref": "#/$defs/Money"
            },
            "transport": {
              "$ref": "#/$defs/Money"
            },
            "staff": {
              "$ref": "#/$defs/Money"
            },
            "energy": {
              "$ref": "#/$defs/Money"
            }
          }
        },
        "volunteerMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "rulePack": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          }
        },
        "safetyIncidents": {
          "type": "integer",
          "minimum": 0,
          "description": "Suspected foodborne illness reports or recalls linked to this distribution (counts only)."
        },
        "note": {
          "$ref": "#/$defs/Note"
        }
      },
      "$ref": "#/$defs/Extensions"
    },
    "Count": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 10
        },
        {
          "const": "<10"
        }
      ]
    },
    "Nutrients": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "energyKcal": {
          "type": "number",
          "minimum": 0
        },
        "proteinG": {
          "type": "number",
          "minimum": 0
        },
        "fatG": {
          "type": "number",
          "minimum": 0
        },
        "saturatedFatG": {
          "type": "number",
          "minimum": 0
        },
        "transFatG": {
          "type": "number",
          "minimum": 0
        },
        "freeSugarsG": {
          "type": "number",
          "minimum": 0
        },
        "sodiumMg": {
          "type": "number",
          "minimum": 0
        },
        "fruitVegG": {
          "type": "number",
          "minimum": 0
        },
        "fibreG": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "applies",
        "check",
        "severity",
        "source"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "nutrient",
            "energy_share",
            "temperature",
            "time",
            "date_mark",
            "allergen"
          ]
        },
        "applies": {
          "enum": [
            "menu_per_person_day",
            "menu_per_meal",
            "item_chilled",
            "item_frozen",
            "item_hot_held",
            "item_cooked",
            "item_any"
          ]
        },
        "check": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "nutrient": {
              "enum": [
                "energyKcal",
                "proteinG",
                "fatG",
                "saturatedFatG",
                "transFatG",
                "freeSugarsG",
                "sodiumMg",
                "fruitVegG",
                "fibreG"
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "mg",
                "g",
                "kcal",
                "pct_energy",
                "degC",
                "hours",
                "days"
              ]
            },
            "dateKind": {
              "enum": [
                "use_by",
                "best_before"
              ]
            },
            "allergen": {
              "const": "unknown"
            }
          }
        },
        "severity": {
          "enum": [
            "block",
            "warn"
          ],
          "description": "block: the receiver should not accept or serve; warn: allowed, recorded as a finding."
        },
        "audience": {
          "type": "string",
          "maxLength": 80,
          "description": "Population the rule is meant for, e.g. 'adults', 'children 2-15 (adjust by energy)'."
        },
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "RulePack": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "id",
        "version",
        "title",
        "status",
        "rules",
        "disclaimer"
      ],
      "unevaluatedProperties": false,
      "description": "Machine-readable nutrition and food-safety rules a program applies to handovers and menus. Packs are versioned and replaceable by local authorities' rules.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "const": "RulePack"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "adopted",
            "retired"
          ]
        },
        "reviewedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "jurisdiction": {
          "type": "string",
          "maxLength": 80
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Rule"
          }
        },
        "disclaimer": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "Manifest": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "org",
        "levels",
        "contact"
      ],
      "unevaluatedProperties": false,
      "description": "Published at /.well-known/cookwala-humanitarian.json by a participating system or organization.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "const": "Manifest"
        },
        "org": {
          "$ref": "#/$defs/OrgId"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Role"
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "H0",
              "H1",
              "H2",
              "H3"
            ]
          }
        },
        "rulePacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
