{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cookwala.ai/v1/schemas/recipe.schema.json",
 "title": "Cookwala Recipe",
 "x-cookwala-status": "core",
 "description": "A recipe a machine can plan, check against local policy, execute and verify. Media type application/vnd.cookwala+json; file extension .cookwala.json. Layers: L0 semantics (dish, yield, ingredients, equipment, nutrition, cost, text), L1 process graph, L2 bindings, L3 safety. L4 policies live in policy.schema.json documents.",
 "type": "object",
 "required": [
  "cookwala",
  "id",
  "revision",
  "verification",
  "dish",
  "yield",
  "ingredients",
  "equipment",
  "process",
  "safety",
  "text",
  "license"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "@context": {
   "description": "Optional JSON-LD context (https://cookwala.ai/v1/context.jsonld) mapping Cookwala terms to schema.org, FoodOn, Wikidata and IEEE 1872.1."
  },
  "cookwala": {
   "$ref": "common.schema.json#/$defs/SpecVersion"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
   "description": "Same as the site recipe id (e.g. fah-234, w-ma-001)."
  },
  "revision": {
   "type": "integer",
   "minimum": 1
  },
  "updated": {
   "type": "string",
   "format": "date"
  },
  "hash": {
   "$ref": "common.schema.json#/$defs/Hash"
  },
  "signature": {
   "$ref": "common.schema.json#/$defs/Signature"
  },
  "legacy": {
   "type": "object",
   "description": "Links back to the existing fifi.cooking representations.",
   "properties": {
    "dataUrl": {
     "type": "string",
     "description": "/data/recipes/{id}.json"
    },
    "pageUrl": {
     "type": "string"
    },
    "schemaOrg": {
     "type": "string",
     "description": "URL of the schema.org Recipe JSON-LD."
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "verification": {
   "$ref": "#/$defs/Verification"
  },
  "dish": {
   "$ref": "#/$defs/Dish"
  },
  "yield": {
   "$ref": "#/$defs/Yield"
  },
  "ingredients": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/Ingredient"
   }
  },
  "equipment": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Equipment"
   }
  },
  "process": {
   "$ref": "#/$defs/Process"
  },
  "safety": {
   "$ref": "#/$defs/Safety"
  },
  "requires": {
   "$ref": "#/$defs/Requirements"
  },
  "nutrition": {
   "$ref": "#/$defs/Nutrition"
  },
  "cost": {
   "$ref": "#/$defs/Cost"
  },
  "storage": {
   "$ref": "#/$defs/Storage"
  },
  "text": {
   "type": "object",
   "description": "Human-readable text per language. Machines must not rely on it for control.",
   "propertyNames": {
    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
   },
   "additionalProperties": {
    "$ref": "#/$defs/Text"
   }
  },
  "bindings": {
   "type": "object",
   "description": "Optional device-class hints, keyed by x-<namespace>. Unknown keys must be ignored.",
   "propertyNames": {
    "pattern": "^x-[a-z0-9.-]+$"
   }
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "citation": {
     "type": "string"
    },
    "collection": {
     "type": "string"
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "license": {
   "type": "string",
   "description": "SPDX id, e.g. CC-BY-4.0."
  },
  "textSidecars": {
   "type": "object",
   "description": "Other languages are served as sidecar files to keep the core document small: {\"languages\": [...], \"url\": \"/v1/recipes/{id}/text/{lang}.json\"}. Each sidecar validates against #/$defs/Text.",
   "properties": {
    "languages": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "url": {
     "type": "string"
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "meta": {
   "$ref": "common.schema.json#/$defs/Meta"
  },
  "identity": {
   "type": "object",
   "description": "What makes this dish itself: elements that must not change (or it becomes another dish) vs elements that may flex. Planners and substitution engines must keep the essentials.",
   "properties": {
    "essential": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Ingredient refs, ops or states that define the dish (e.g. eggs poached in spiced tomato-pepper sauce)."
    },
    "flexible": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "neverAdd": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Additions that break authenticity or the dish's dietary character."
    },
    "family": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Related dishes/variants (for repurposing and suggestions)."
    },
    "culturalNotes": {
     "$ref": "common.schema.json#/$defs/LangMap"
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "sensory": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/SensoryTarget"
   },
   "description": "Sensory targets per stage and for the finished dish."
  },
  "formula": {
   "type": "object",
   "description": "Scalable proportions: quantities as ratios to a base, with role and flex range. Lets planners scale, ration, budget and substitute without breaking the dish.",
   "properties": {
    "base": {
     "type": "string",
     "description": "Ingredient ref used as 1.0 (e.g. tomato)."
    },
    "ratios": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "ref",
       "ratio"
      ],
      "properties": {
       "ref": {
        "type": "string"
       },
       "ratio": {
        "type": "number"
       },
       "min": {
        "type": "number"
       },
       "max": {
        "type": "number"
       },
       "role": {
        "type": "string"
       },
       "scaling": {
        "enum": [
         "linear",
         "sublinear",
         "fixed",
         "to_taste"
        ]
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "perServing": {
     "type": "object",
     "description": "Base-ingredient grams per serving at reference portion.",
     "properties": {
      "baseG": {
       "type": "number"
      },
      "cookedG": {
       "type": "number"
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "prep": {
   "type": "object",
   "description": "Mise en place for the environment: what must be true or done before cooking starts (tools found and clean, surfaces cleared, space, ingredients staged, pre-tasks like soaking).",
   "properties": {
    "tools": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "ref": {
        "type": "string"
       },
       "clean": {
        "type": "boolean"
       },
       "dry": {
        "type": "boolean"
       },
       "stageAt": {
        "type": "string",
        "description": "Zone, e.g. counter-left."
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "surfaces": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "zone": {
        "type": "string"
       },
       "clearAreaCm2": {
        "type": "number"
       },
       "sanitized": {
        "type": "boolean"
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "stageIngredients": {
     "type": "boolean",
     "default": true
    },
    "advanceTasks": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "task": {
        "type": "string"
       },
       "lead": {
        "$ref": "common.schema.json#/$defs/Duration"
       },
       "node": {
        "$ref": "#/$defs/Node"
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     },
     "description": "Soak, thaw, marinate, preheat: scheduled ahead by planners."
    },
    "clearFirst": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "e.g. sink, hob, counter-left (planner adds tidy/wash/dry tasks if occupied)."
    },
    "estimatedPrepTime": {
     "$ref": "common.schema.json#/$defs/Duration"
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "service": {
   "type": "object",
   "description": "How the dish is served and eaten.",
   "properties": {
    "servingTempC": {
     "$ref": "common.schema.json#/$defs/Range"
    },
    "maxHoldBeforeServe": {
     "$ref": "common.schema.json#/$defs/Duration"
    },
    "plating": {
     "$ref": "common.schema.json#/$defs/LangMap"
    },
    "vessel": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Serving vessel classes (shared pan, bowl, plate, lunchbox)."
    },
    "accompaniments": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "item": {
        "type": "string"
       },
       "recipeId": {
        "$ref": "common.schema.json#/$defs/GlobalRef"
       },
       "optional": {
        "type": "boolean"
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "tableware": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "e.g. spoon, bread for scooping, fork, chopsticks."
    },
    "eatingStyle": {
     "type": "array",
     "items": {
      "enum": [
       "utensils",
       "by_hand",
       "bread_scoop",
       "chopsticks",
       "shared_platter",
       "individual"
      ]
     }
    },
    "portioning": {
     "type": "object",
     "properties": {
      "unit": {
       "type": "string"
      },
      "divisible": {
       "type": "boolean"
      },
      "perPersonMin": {
       "type": "number"
      },
      "perPersonMax": {
       "type": "number"
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    },
    "packable": {
     "type": "object",
     "properties": {
      "lunchbox": {
       "type": "boolean"
      },
      "travelMax": {
       "$ref": "common.schema.json#/$defs/Duration"
      },
      "notes": {
       "type": "string"
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "acceptance": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/FoodState"
   },
   "description": "Final acceptance checks (the recipe's 'tests'): the dish is done and right when these hold."
  },
  "layers": {
   "type": "object",
   "description": "Which knowledge layers this document carries (WHO-SMART-style): R1 narrative, R2 dish spec, R3 executable IR. R4 bound plans live in Missions.",
   "properties": {
    "r1": {
     "type": "boolean"
    },
    "r2": {
     "type": "boolean"
    },
    "r3": {
     "type": "boolean"
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  }
 },
 "additionalProperties": false,
 "$defs": {
  "Verification": {
   "type": "object",
   "required": [
    "level"
   ],
   "properties": {
    "level": {
     "enum": [
      "V0",
      "V1",
      "V2",
      "V3"
     ],
     "description": "V0 described · V1 structured · V2 simulated + reviewed · V3 field-verified."
    },
    "evidence": {
     "type": "object",
     "properties": {
      "simulatorRuns": {
       "type": "integer",
       "minimum": 0
      },
      "humanReviews": {
       "type": "integer",
       "minimum": 0
      },
      "fieldReports": {
       "type": "integer",
       "minimum": 0
      },
      "deviceClasses": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "incidents": {
       "type": "integer",
       "minimum": 0
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    },
    "reviewedBy": {
     "type": "string"
    },
    "generatedBy": {
     "type": "string",
     "description": "Tool/model that produced the process graph, for audit."
    },
    "notes": {
     "type": "string"
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "Dish": {
   "type": "object",
   "required": [
    "names"
   ],
   "properties": {
    "names": {
     "$ref": "common.schema.json#/$defs/LangMap"
    },
    "localName": {
     "type": "string"
    },
    "cuisine": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
     },
     "description": "ISO 3166-1 alpha-2 countries."
    },
    "course": {
     "enum": [
      "breakfast",
      "starter",
      "soup",
      "salad",
      "main",
      "side",
      "bread",
      "dessert",
      "snack",
      "drink",
      "sauce",
      "condiment",
      "baby",
      "other"
     ]
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "difficulty": {
     "enum": [
      "easy",
      "medium",
      "hard"
     ]
    },
    "wikidata": {
     "type": "string",
     "pattern": "^Q[0-9]+$"
    },
    "images": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "url"
      ],
      "properties": {
       "url": {
        "type": "string"
       },
       "role": {
        "enum": [
         "banner",
         "thumb",
         "step",
         "reference_done"
        ]
       },
       "width": {
        "type": "integer"
       },
       "height": {
        "type": "integer"
       },
       "node": {
        "type": "string"
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     }
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "Yield": {
   "type": "object",
   "required": [
    "servings"
   ],
   "properties": {
    "servings": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "totalMass": {
     "$ref": "common.schema.json#/$defs/Quantity"
    },
    "scaling": {
     "type": "object",
     "properties": {
      "minScale": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "maxScale": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "timeExponent": {
       "type": "number",
       "description": "How cooking time scales with mass (0 = constant, 0.66 typical for roasts)."
      },
      "note": {
       "type": "string"
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "Prep": {
   "type": "object",
   "properties": {
    "op": {
     "type": "string"
    },
    "shape": {
     "enum": [
      "whole",
      "halve",
      "quarter",
      "slice",
      "dice",
      "brunoise",
      "julienne",
      "chop",
      "chop_fine",
      "mince",
      "grate",
      "crush",
      "puree",
      "cube",
      "strip",
      "wedge",
      "ring",
      "peel_only",
      "zest",
      "juice"
     ]
    },
    "size": {
     "$ref": "common.schema.json#/$defs/Quantity"
    },
    "remove": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "soak": {
     "type": "object",
     "properties": {
      "liquid": {
       "type": "string"
      },
      "duration": {
       "$ref": "common.schema.json#/$defs/Duration"
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "Ingredient": {
   "type": "object",
   "required": [
    "ref",
    "ingredientId",
    "qty"
   ],
   "properties": {
    "ref": {
     "$ref": "common.schema.json#/$defs/LocalRef"
    },
    "ingredientId": {
     "$ref": "common.schema.json#/$defs/VocabId"
    },
    "legacyId": {
     "type": "string",
     "description": "masterIngredients[].id in the site data."
    },
    "qty": {
     "$ref": "common.schema.json#/$defs/Quantity"
    },
    "display": {
     "$ref": "common.schema.json#/$defs/LangMap"
    },
    "prep": {
     "$ref": "#/$defs/Prep"
    },
    "startTemp": {
     "enum": [
      "frozen",
      "fridge",
      "room",
      "warm",
      "hot"
     ]
    },
    "scaling": {
     "enum": [
      "linear",
      "sublinear",
      "fixed"
     ],
     "default": "linear"
    },
    "toTaste": {
     "type": "boolean"
    },
    "optional": {
     "type": "boolean"
    },
    "substitutions": {
     "type": "array",
     "description": "Equivalents that keep the dish the same. Never used to bypass dietary rules.",
     "items": {
      "type": "object",
      "required": [
       "ingredientId",
       "qty"
      ],
      "properties": {
       "ingredientId": {
        "$ref": "common.schema.json#/$defs/VocabId"
       },
       "qty": {
        "$ref": "common.schema.json#/$defs/Quantity"
       },
       "note": {
        "type": "string"
       }
      },
      "unevaluatedProperties": false,
      "patternProperties": {
       "^x-": {}
      }
     }
    },
    "gtin": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[0-9]{8,14}$"
     },
     "description": "Optional example GS1 product codes for ordering."
    },
    "allergens": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Computed from the vocabulary; repeated here for offline use."
    },
    "economy": {
     "type": "object",
     "description": "Budget/ration hints.",
     "properties": {
      "costClass": {
       "enum": [
        "cheap",
        "moderate",
        "expensive"
       ]
      },
      "stretchable": {
       "type": "boolean",
       "description": "Can be reduced or bulked out without changing the dish's identity."
      },
      "minRatio": {
       "type": "number",
       "description": "Lowest fraction of qty that still gives an acceptable dish."
      },
      "bulkWith": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Ingredient ids that can extend it (e.g. lentils for minced meat)."
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    },
    "certifications": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/CertificationRef"
     },
     "description": "Certifications of this ingredient, lot or product (RFC-0010)."
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "Equipment": {
   "type": "object",
   "required": [
    "ref",
    "class"
   ],
   "properties": {
    "ref": {
     "$ref": "common.schema.json#/$defs/LocalRef"
    },
    "class": {
     "$ref": "common.schema.json#/$defs/VocabId"
    },
    "optional": {
     "type": "boolean"
    },
    "constraints": {
     "type": "object",
     "properties": {
      "diameterMm": {
       "$ref": "common.schema.json#/$defs/Range"
      },
      "capacityMl": {
       "$ref": "common.schema.json#/$defs/Range"
      },
      "powerW": {
       "$ref": "common.schema.json#/$defs/Range"
      },
      "maxTempC": {
       "type": "number"
      },
      "lid": {
       "type": "boolean"
      },
      "material": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "inductionCompatible": {
       "type": "boolean"
      },
      "ovenSafe": {
       "type": "boolean"
      }
     },
     "unevaluatedProperties": false,
     "patternProperties": {
      "^x-": {}
     }
    }
   },
   "unevaluatedProperties": false,
   "patternProperties": {
    "^x-": {}
   }
  },
  "Node": {
   "type": "object",
   "required": [
    "id",
    "op"
   ],
   "properties": {
    "id": {
     "$ref": "common.schema.json#/$defs/LocalRef"
    },
    "op": {
