{
 "id": "075",
 "slug": "the-impact-summary-document",
 "audience": "regulator",
 "northStar": ["hunger"],
 "level": "beginner",
 "title": {"en": "The impact summary: every measure says how it was obtained"},
 "goal": {"en": "An ImpactSummary is computed from a folder of offers, claims, handovers and distributions. Each measure carries a value, a unit, a method and a source, and the document lists what went wrong and what is unknown. Validate and hash the four example summaries."},
 "docs": ["/docs/HUMANITARIAN-PROFILE/", "/humanitarian/"],
 "requires": ["hub", "repo"],
 "steps": [
  {"op": "validate", "args": {"kind": "humanitarian", "doc": {"$file": "examples/humanitarian/flows/food-bank-cairo/impact-summary.json"}}, "save": "cairo", "note": {"en": "The Cairo food bank's November summary validates."}, "expect": {"ok": true}},
  {"op": "hash", "args": {"doc": {"$file": "examples/humanitarian/flows/food-bank-cairo/impact-summary.json"}}, "save": "cairoHash", "note": {"en": "Its content hash: the value a regulator can quote when citing the summary."}, "expect": {"hash": "sha256:eda7e2205fb07e9745e301208cc4b8a9ab0e54ddf9c791a9baf512cc8b7b7bc5"}},
  {"op": "hash", "args": {"doc": {"$file": "examples/humanitarian/flows/school-meals/impact-summary.json"}}, "save": "schoolHash", "note": {"en": "The school-meals summary."}, "expect": {"hash": "sha256:c9dbb3c8a8fdaffbe03c239b7f0fa6cae5f8c5e021585a17aebaeca5540abf2b"}},
  {"op": "hash", "args": {"doc": {"$file": "examples/humanitarian/flows/disaster-kitchen/impact-summary.json"}}, "save": "disasterHash", "note": {"en": "The disaster-kitchen summary."}, "expect": {"hash": "sha256:de065ed850673ae3e975f85130e693ca2c515eb7853aac39fc6fab2108e850cc"}},
  {"op": "hash", "args": {"doc": {"$file": "examples/humanitarian/flows/robot-kitchen/impact-summary.json"}}, "save": "robotHash", "note": {"en": "The robot-kitchen summary."}, "expect": {"hash": "sha256:f3640f78bbe864521e6dec9c999e95d2fd61bda5595ec5fa4c76d1215f9711a3"}}
 ],
 "cli": [
  "cookwala humanitarian --summary examples/humanitarian/flows/food-bank-cairo --org did:web:food-bank-cairo.example --from 2026-11-01 --to 2026-11-30",
  "cookwala hash examples/humanitarian/flows/food-bank-cairo/impact-summary.json"
 ],
 "outcome": {"en": "You can cite a summary by hash and recompute it from the documents with the command above. Next: scenario 077 does the same for rule packs."},
 "tags": ["humanitarian", "impact-summary", "measures", "regulator"]
}
