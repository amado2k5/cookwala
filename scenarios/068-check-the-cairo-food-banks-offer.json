{
 "id": "068",
 "slug": "check-the-cairo-food-banks-offer",
 "audience": "food_bank",
 "northStar": ["hunger"],
 "level": "beginner",
 "title": {"en": "Check the Cairo food bank's recorded offer against the rule packs"},
 "goal": {"en": "The food-bank-cairo flow records a supermarket offer of tomatoes, yogurt and bread with a fridge reading of 3.8 °C. Check it with the basic pack and with the care pack added, validate it, and parse the SMS the offer came from."},
 "docs": ["/docs/HUMANITARIAN-PROFILE/", "/humanitarian/"],
 "requires": ["hub", "repo"],
 "steps": [
  {"op": "humanitarianCheck", "args": {"docs": [{"profile": "0.2.0", "kind": "Offer", "id": "of-2026-11-09-012", "donor": "did:web:supermarket.example", "createdAt": "2026-11-09T17:40:00+02:00", "items": [{"lineId": "1", "name": "Tomatoes", "ingredientId": "cw.ing.tomato", "kg": 80, "storage": "ambient", "origin": "retail", "dateMark": {"kind": "best_before", "date": "2026-11-11"}, "allergens": []}, {"lineId": "2", "name": "Yogurt cups", "gtin": "6221234567890", "kg": 24, "units": 160, "storage": "chilled", "origin": "retail", "dateMark": {"kind": "use_by", "date": "2026-11-12"}, "allergens": ["milk"]}, {"lineId": "3", "name": "Bread", "kg": 30, "storage": "ambient", "origin": "retail", "dateMark": {"kind": "best_before", "date": "2026-11-10"}, "allergens": ["cereals_gluten"]}], "window": {"from": "2026-11-09T18:00:00+02:00", "to": "2026-11-10T08:00:00+02:00"}, "site": {"country": "EG", "admin1": "Cairo", "admin2": "Nasr City", "siteName": "Supermarket loading bay"}, "readings": [{"at": "2026-11-09T17:35:00+02:00", "tempC": 3.8, "method": "fridge_display", "lineId": "2"}], "needs": ["refrigerated_vehicle"], "state": "distributed", "version": 5, "note": "Sent by SMS: OFFER 80KG TOMATOES A BB1111; OFFER 24KG YOGURT C 3.8C UB1211; OFFER 30KG BREAD A BB1011. Gateway grouped them under one offer id."}], "packs": ["basic-nutrition-food-safety"]}, "save": "basic", "note": {"en": "The basic WHO/Codex pack finds nothing: the yogurt reading is under 5 °C and every date mark is in the future."}, "expect": {"results[0].id": "of-2026-11-09-012", "results[0].kind": "Offer", "results[0].findings.length": 0}},
  {"op": "humanitarianCheck", "args": {"docs": [{"profile": "0.2.0", "kind": "Offer", "id": "of-2026-11-09-012", "donor": "did:web:supermarket.example", "createdAt": "2026-11-09T17:40:00+02:00", "items": [{"lineId": "1", "name": "Tomatoes", "ingredientId": "cw.ing.tomato", "kg": 80, "storage": "ambient", "origin": "retail", "dateMark": {"kind": "best_before", "date": "2026-11-11"}, "allergens": []}, {"lineId": "2", "name": "Yogurt cups", "gtin": "6221234567890", "kg": 24, "units": 160, "storage": "chilled", "origin": "retail", "dateMark": {"kind": "use_by", "date": "2026-11-12"}, "allergens": ["milk"]}, {"lineId": "3", "name": "Bread", "kg": 30, "storage": "ambient", "origin": "retail", "dateMark": {"kind": "best_before", "date": "2026-11-10"}, "allergens": ["cereals_gluten"]}], "window": {"from": "2026-11-09T18:00:00+02:00", "to": "2026-11-10T08:00:00+02:00"}, "site": {"country": "EG", "admin1": "Cairo", "admin2": "Nasr City", "siteName": "Supermarket loading bay"}, "readings": [{"at": "2026-11-09T17:35:00+02:00", "tempC": 3.8, "method": "fridge_display", "lineId": "2"}], "needs": ["refrigerated_vehicle"], "state": "distributed", "version": 5, "note": "Sent by SMS: OFFER 80KG TOMATOES A BB1111; OFFER 24KG YOGURT C 3.8C UB1211; OFFER 30KG BREAD A BB1011. Gateway grouped them under one offer id."}], "packs": ["basic-nutrition-food-safety", "care-vulnerable-groups"]}, "save": "care", "note": {"en": "Adding the care pack for vulnerable groups changes nothing for this offer."}, "expect": {"results[0].findings.length": 0}},
  {"op": "validate", "args": {"kind": "humanitarian", "doc": {"$file": "examples/humanitarian/flows/food-bank-cairo/offer.json"}}, "save": "valid", "note": {"en": "The document validates as a Humanitarian Profile document."}, "expect": {"ok": true, "errors.length": 0}},
  {"op": "parseSms", "args": {"text": "OFFER 24KG YOGURT C 3.8C UB1211"}, "save": "yogurt", "note": {"en": "The yogurt line as it was sent by SMS, per the offer's note: chilled at 3.8 °C, use by 12 November, no gateway finding."}, "expect": {"tempC": 3.8, "dateMark.dayMonth": "12-11", "findings.length": 0}}
 ],
 "cli": [
  "cookwala humanitarian examples/humanitarian/flows/food-bank-cairo/offer.json",
  "cookwala humanitarian --pack profiles/humanitarian/basic-nutrition-food-safety.rulepack.json --pack profiles/humanitarian/care-vulnerable-groups.rulepack.json examples/humanitarian/flows/food-bank-cairo/offer.json",
  "cookwala sms \"OFFER 24KG YOGURT C 3.8C UB1211\""
 ],
 "outcome": {"en": "You have checked a real example document against two packs and seen a clean result. Next: scenario 070 checks an offer that fails."},
 "tags": ["humanitarian", "rule-pack", "food-bank", "offer"]
}
