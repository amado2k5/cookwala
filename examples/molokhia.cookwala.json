 "text": {
  "en": {
   "title": "Molokhia with chicken",
   "intro": "Egypt's green soup-stew of jute leaves in chicken stock, finished with the taqliya: garlic and coriander fried in ghee and poured in sizzling.",
   "steps": {
    "n1": "Put the chicken, water, onion, cardamom and salt in the pot. Bring to the boil, skimming the foam.",
    "n2": "Lower to a simmer, lid ajar, until the thickest piece reads 74 °C at the bone (40 to 70 minutes).",
    "n3": "Lift the chicken out and keep it warm. Keep 1.5 litres of stock in the pot.",
    "n4": "Add the molokhia to the stock and heat just below the boil, stirring gently, until the leaves disperse (5 to 9 minutes). Never let it boil hard.",
    "n5": "Crush the garlic coarsely.",
    "n6": "Heat the ghee in a small pan.",
    "n7": "Fry the garlic and coriander in the ghee until golden and fragrant, 30 to 90 seconds.",
    "n8": "Pour the sizzling taqliya into the molokhia. It will spit; stir once.",
    "n9": "Taste; add salt if needed.",
    "n10": "Keep hot, at or above 60 °C, until serving.",
    "n11": "Serve with the chicken and rice with vermicelli.",
    "n12": "Keep the chicken pieces hot, at or above 60 °C, until serving."
   }
  },
  "ar": {
   "title": "ملوخية بالفراخ",
   "intro": "شوربة مصر الخضراء: ورق الملوخية في شوربة الفراخ، تُختم بالتقلية: ثوم وكسبرة في السمن تُسكب وهي تصدر صوتها.",
   "steps": {
    "n1": "ضعي الفراخ والماء والبصل والحبهان والملح في الحلة. اتركيها تغلي مع إزالة الرغوة.",
    "n2": "اخفضي النار إلى الهدوء مع الغطاء نصف مفتوح حتى يصل مركز أكبر قطعة عند العظم إلى 74 درجة (40 إلى 70 دقيقة).",
    "n3": "ارفعي الفراخ واحتفظي بها دافئة. احتفظي بلتر ونصف من الشوربة في الحلة.",
    "n4": "أضيفي الملوخية إلى الشوربة وسخّنيها تحت درجة الغليان مع التقليب بلطف حتى تتفرق الورقات (5 إلى 9 دقائق). لا تتركيها تغلي بقوة.",
    "n5": "اهرسي الثوم هرسًا خشنًا.",
    "n6": "سخّني السمن في مقلاة صغيرة.",
    "n7": "حمّري الثوم والكسبرة في السمن حتى يصبح ذهبيًا وتفوح رائحته، من 30 إلى 90 ثانية.",
    "n8": "اسكبي التقلية وهي تصدر صوتًا على الملوخية؛ ستطرطش، فقلّبي مرة واحدة.",
    "n9": "تذوّقي وأضيفي الملح إذا لزم.",
    "n10": "احتفظي بها ساخنة عند 60 درجة أو أكثر حتى التقديم.",
    "n11": "قدّميها مع الفراخ والأرز بالشعرية.",
    "n12": "احفظي قطع الدجاج ساخنة، عند 60 درجة أو أكثر، حتى التقديم."
   }
  }
 },
