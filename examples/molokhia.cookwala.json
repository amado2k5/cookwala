     "hob"
    ],
    "params": {
     "heat": "high",
     "lid": "off",
     "target": {
      "sensor": "cw.sense.liquid_temp",
      "value": 100,
      "unit": "degC",
      "tolerance": 2
     }
    },
    "until": {
     "any": [
      {
       "sensor": "cw.sense.liquid_temp",
       "gte": 98
      },
      {
       "vision": "cw.sense.boil_detect"
      }
     ],
     "minTime": "PT8M",
     "maxTime": "PT18M"
    },
    "onTimeout": "extend",
    "hazards": [
     "hz_raw_poultry",
     "hz_steam",
     "hz_boilover"
    ],
    "attention": "monitor",
    "notes": {
