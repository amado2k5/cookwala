     "lid": "ajar",
     "target": {
      "sensor": "cw.sense.liquid_temp",
      "value": 92,
      "unit": "degC",
      "tolerance": 4
     }
    },
    "until": {
     "all": [
      {
       "sensor": "cw.sense.core_temp",
       "target": "chicken",
