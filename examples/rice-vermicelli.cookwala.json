 },
 "dish": {
  "names": {
   "en": "Egyptian rice with vermicelli",
   "ar": "رز بالشعرية"
  },
  "cuisine": [
   "EG"
  ],
  "course": "side",
  "tags": [
   "rice",
   "vermicelli",
   "side",
   "staple"
  ]
 },
 "yield": {
  "servings": 6,
  "totalMass": {
   "value": 1400,
   "unit": "g"
  }
 },
 "ingredients": [
  {
   "ref": "rice",
   "ingredientId": "cw.ing.rice_short",
   "qty": {
    "value": 400,
    "unit": "g",
    "tolerance": 0.1
   },
   "display": {
    "en": "400 g short-grain rice",
    "ar": "400 جم أرز مصري"
   }
  },
  {
   "ref": "vermicelli",
   "ingredientId": "cw.ing.vermicelli_wheat",
   "qty": {
    "value": 60,
    "unit": "g",
    "tolerance": 0.2
   },
   "display": {
    "en": "60 g vermicelli",
    "ar": "60 جم شعرية"
   }
  },
  {
   "ref": "ghee",
   "ingredientId": "cw.ing.ghee",
   "qty": {
    "value": 30,
    "unit": "ml",
    "tolerance": 0.3
   },
   "display": {
    "en": "2 tbsp ghee or oil",
    "ar": "2 ملعقة كبيرة سمن أو زيت"
   }
  },
  {
   "ref": "water",
   "ingredientId": "cw.ing.water",
   "qty": {
    "value": 700,
    "unit": "ml",
    "tolerance": 0.1
   },
   "display": {
    "en": "700 ml hot water",
    "ar": "700 مل ماء ساخن"
   }
  },
  {
   "ref": "salt",
   "ingredientId": "cw.ing.salt",
   "qty": {
    "value": 5,
    "unit": "g",
    "tolerance": 0.3
   },
   "display": {
    "en": "1 tsp salt",
    "ar": "ملعقة صغيرة ملح"
   },
   "scaling": "sublinear"
  }
 ],
 "equipment": [
  {
   "ref": "pot",
   "class": "cw.eq.vessel.pot.sauce",
   "constraints": {
    "capacityMl": {
     "min": 2500
    },
    "lid": true
   }
  },
  {
   "ref": "hob",
   "class": "cw.eq.heat.hob"
  },
  {
   "ref": "colander",
   "class": "cw.eq.tool.colander"
  },
  {
   "ref": "spoon",
   "class": "cw.eq.tool.spoon.wooden"
  },
  {
   "ref": "probe",
   "class": "cw.eq.sensor.probe",
   "optional": true
  }
 ],
 "process": {
  "nodes": [
   {
    "id": "n1",
    "op": "cw.op.wash",
    "inputs": [
     "rice"
    ],
    "output": "rice_washed",
    "equipment": [
     "colander"
    ],
    "params": {
     "repeats": 3
    }
   },
   {
    "id": "n2",
    "op": "cw.op.drain",
    "inputs": [
     "rice_washed"
    ],
    "output": "rice_drained",
    "equipment": [
     "colander"
    ],
    "params": {
     "keepLiquid": false
    },
    "until": {
     "minTime": "PT10M",
     "maxTime": "PT30M"
    },
    "onTimeout": "extend"
   },
   {
    "id": "n3",
    "op": "cw.op.heat",
    "inputs": [
     "ghee"
    ],
    "output": "hot_ghee",
    "equipment": [
     "pot",
     "hob"
    ],
    "params": {
     "heat": "medium",
     "target": {
      "sensor": "cw.sense.pan_surface_temp",
      "value": 165,
      "unit": "degC",
      "tolerance": 15
     }
    },
    "until": {
     "any": [
      {
       "sensor": "cw.sense.pan_surface_temp",
       "gte": 150
      },
      {
       "vision": "cw.sense.oil_shimmer"
      }
     ],
     "minTime": "PT1M",
     "maxTime": "PT4M"
    },
    "onTimeout": "extend",
    "hazards": [
     "hz_oil"
    ],
    "attention": "continuous"
   },
   {
    "id": "n4",
    "op": "cw.op.toast",
    "inputs": [
     "hot_ghee",
     "vermicelli"
    ],
    "output": "vermicelli_golden",
    "params": {
     "heat": "medium",
     "stir": {
      "intervalS": 15,
      "style": "normal"
     },
     "target": {
      "sensor": "cw.sense.pan_surface_temp",
      "value": 165,
      "unit": "degC",
      "tolerance": 20
     }
    },
    "until": {
     "all": [
      {
       "vision": "cw.sense.color_golden",
       "target": "vermicelli"
      }
     ],
     "minTime": "PT2M",
     "maxTime": "PT4M"
    },
    "onTimeout": "ask_human",
    "hazards": [
     "hz_oil",
     "hz_scorch"
    ],
    "attention": "continuous",
    "notes": {
     "en": "Vermicelli goes from golden to burnt in seconds; stir constantly."
    }
   },
   {
    "id": "n5",
    "op": "cw.op.saute",
    "inputs": [
     "vermicelli_golden",
     "rice_drained"
    ],
    "output": "rice_coated",
    "params": {
     "heat": "medium",
     "stir": {
      "intervalS": 20
     }
    },
    "until": {
     "minTime": "PT1M",
     "maxTime": "PT2M"
    },
    "onTimeout": "extend",
    "hazards": [
     "hz_oil"
    ],
    "attention": "continuous"
   },
   {
    "id": "n6",
    "op": "cw.op.boil",
    "inputs": [
     "rice_coated",
     "water",
     "salt"
    ],
    "output": "rice_boiling",
    "params": {
     "heat": "high",
     "lid": "off",
     "target": {
      "sensor": "cw.sense.liquid_temp",
      "value": 100,
      "unit": "degC",
      "tolerance": 2
     }
    },
    "until": {
     "any": [
      {
       "sensor": "cw.sense.liquid_temp",
       "gte": 98
      },
      {
       "vision": "cw.sense.boil_detect"
      }
     ],
     "minTime": "PT2M",
     "maxTime": "PT8M"
    },
    "onTimeout": "extend",
    "hazards": [
     "hz_steam",
     "hz_boilover"
    ],
    "attention": "monitor"
   },
   {
    "id": "n7",
    "op": "cw.op.simmer",
    "inputs": [
     "rice_boiling"
    ],
    "output": "rice_cooked",
    "params": {
     "heat": "very_low",
     "lid": "on",
     "target": {
      "sensor": "cw.sense.liquid_temp",
      "value": 94,
      "unit": "degC",
      "tolerance": 2
     }
    },
    "until": {
     "all": [
      {
       "vision": "cw.sense.liquid_absorbed"
      }
     ],
     "minTime": "PT12M",
     "maxTime": "PT16M"
    },
    "onTimeout": "ask_human",
    "hazards": [
     "hz_scorch",
     "hz_steam"
    ],
    "attention": "periodic",
    "notes": {
     "en": "Do not lift the lid or stir while the rice steams."
    }
   },
   {
    "id": "n8",
    "op": "cw.op.rest",
    "inputs": [
     "rice_cooked"
    ],
    "output": "rice_rested",
    "params": {
     "cover": true
    },
    "until": {
     "minTime": "PT8M",
     "maxTime": "PT15M"
    },
    "onTimeout": "extend"
   },
   {
    "id": "n9",
    "op": "cw.op.serve",
    "inputs": [
     "rice_rested"
    ],
    "params": {
     "serveWithin": "PT30M",
     "keepHot": {
      "gte": 60,
      "unit": "degC"
     }
    }
   }
  ],
  "edges": "implicit-from-inputs"
 },
