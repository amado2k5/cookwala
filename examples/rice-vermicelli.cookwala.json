 "text": {
  "en": {
   "title": "Egyptian rice with vermicelli",
   "intro": "The rice that sits beside almost every Egyptian main: short-grain rice with toasted vermicelli, steamed by absorption.",
   "steps": {
    "n1": "Rinse the rice three times until the water runs almost clear.",
    "n2": "Drain well for 10 to 30 minutes.",
    "n3": "Heat the ghee in the pot over medium heat.",
    "n4": "Toast the vermicelli, stirring without stopping, until golden brown.",
    "n5": "Add the rice and stir for a minute to coat every grain.",
    "n6": "Pour in the hot water and salt; bring to the boil.",
    "n7": "Turn the heat to the lowest setting, cover tightly and steam until the water is absorbed (12 to 16 minutes).",
    "n8": "Rest, covered, off the heat for 8 to 15 minutes, then fluff.",
    "n9": "Serve hot within 30 minutes."
   }
  },
  "ar": {
   "title": "رز بالشعرية",
   "intro": "الأرز الذي يرافق كل الأطباق المصرية الرئيسية تقريبًا: أرز مصري مع شعرية محمّرة، يُطهى بالتشرّب.",
   "steps": {
    "n1": "اغسلي الأرز ثلاث مرات حتى يصفو الماء تقريبًا.",
    "n2": "صفّيه جيدًا من 10 إلى 30 دقيقة.",
    "n3": "سخّني السمن في الحلة على نار متوسطة.",
    "n4": "حمّري الشعرية مع التقليب المستمر حتى تصبح ذهبية.",
    "n5": "أضيفي الأرز وقلّبي دقيقة حتى تتغلف الحبوب.",
    "n6": "اسكبي الماء الساخن والملح واتركيه يغلي.",
    "n7": "اخفضي النار إلى أقل درجة، وغطّي الحلة بإحكام حتى يتشرب الأرز الماء (12 إلى 16 دقيقة).",
    "n8": "ارفعيه عن النار واتركيه مغطى من 8 إلى 15 دقيقة ثم فكّكيه بالشوكة.",
    "n9": "قدّميه ساخنًا خلال 30 دقيقة."
   }
  }
 },
