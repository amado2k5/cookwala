 "text": {
  "en": {
   "title": "Egyptian salad (salata baladi)",
   "intro": "The fresh chopped salad on every Egyptian table: tomato, cucumber, onion and parsley with lemon and olive oil. No heat, so a robot arm with a camera can make it on its own.",
   "steps": {
    "n1": "Wash the vegetables and the parsley well.",
    "n2": "Dice the tomato, cucumber and pepper small; chop the parsley finely.",
    "n3": "Chop the onion very fine.",
    "n4": "Whisk the lemon juice, olive oil, salt and cumin.",
    "n5": "Toss everything together gently.",
    "n6": "Chill for a few minutes if there is time.",
    "n7": "Serve within half an hour, before the tomato weeps."
   }
  },
  "ar": {
   "title": "سلطة بلدي",
   "intro": "السلطة الطازجة على كل مائدة مصرية: طماطم وخيار وبصل وبقدونس بالليمون وزيت الزيتون. بلا نار، فيستطيع ذراع آلي بكاميرا إعدادها وحده.",
   "steps": {
    "n1": "اغسلي الخضار والبقدونس جيدًا.",
    "n2": "قطّعي الطماطم والخيار والفلفل مكعبات صغيرة، وافرمي البقدونس ناعمًا.",
    "n3": "افرمي البصل ناعمًا جدًا.",
    "n4": "اخفقي عصير الليمون وزيت الزيتون والملح والكمون.",
    "n5": "اخلطي كل شيء بلطف.",
    "n6": "ضعيها في الثلاجة بضع دقائق إن توفر الوقت.",
    "n7": "قدّميها خلال نصف ساعة قبل أن تُخرج الطماطم ماءها."
   }
  }
 },
