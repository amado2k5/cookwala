      "value": 170,
      "unit": "degC",
      "tolerance": 15
     }
    },
    "until": {
     "any": [
      {
       "sensor": "cw.sense.pan_surface_temp",
       "gte": 160
      },
      {
       "vision": "cw.sense.oil_shimmer"
      }
     ],
     "minTime": "PT1M",
     "maxTime": "PT4M"
    },
    "onTimeout": "extend",
    "hazards": [
     "hz_oil"
    ],
    "attention": "monitor",
    "space": {
     "zone": "hob",
     "keepClearOfChildren": true
    }
   },
   {
    "id": "n5",
    "op": "cw.op.saute",
    "inputs": [
     "hot_oil",
     "onion_diced",
     "pepper_diced"
