     "checkShell": true
    },
    "hazards": [
     "hz_allergen_egg"
    ],
    "affordances": {
     "grasp": [
      "egg_pinch"
     ],
     "forceN": {
      "min": 2,
      "max": 8
     },
     "precisionMm": 10,
     "hygiene": [
      "wash_after_raw_egg"
     ]
    }
   },
   {
    "id": "n11",
    "op": "cw.op.simmer",
    "inputs": [
     "eggs_in_wells"
