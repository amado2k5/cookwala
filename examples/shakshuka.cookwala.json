      "incident": "cw.incident.too_thin",
      "likelihood": "medium",
      "playbook": "cw.pb.sauce_too_thin"
     }
    ]
   },
   {
    "id": "n8",
    "op": "cw.op.season",
    "inputs": [
     "sauce"
    ],
    "output": "sauce_seasoned",
    "params": {
     "method": "taste_adjust",
     "ingredients": [
      "salt"
     ]
    },
    "humanOptional": true
   },
   {
    "id": "n9",
