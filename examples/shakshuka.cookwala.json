 "process": {
  "nodes": [
   {
    "id": "n1",
    "op": "cw.op.cut",
    "inputs": [
     "onion"
    ],
    "output": "onion_diced",
    "equipment": [
     "knife",
     "board"
    ],
    "params": {
     "shape": "dice",
     "size": {
      "value": 10,
      "unit": "mm"
     }
    },
    "hazards": [
     "hz_knife"
    ]
   },
   {
    "id": "n2",
    "op": "cw.op.cut",
    "inputs": [
     "pepper"
    ],
