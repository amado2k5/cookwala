       "medium heat"
      ],
      "playbook": "cw.pb.scorched_bottom"
     }
    ],
    "space": {
     "zone": "hob",
     "keepClearOfChildren": true
    }
   },
   {
    "id": "n6",
    "op": "cw.op.saute",
    "inputs": [
     "veg_soft",
     "garlic_minced",
     "cumin",
     "paprika"
    ],
    "output": "aromatic_base",
    "params": {
     "heat": "medium_low",
     "stir": {
      "intervalS": 15
     }
    },
    "until": {
     "minTime": "PT45S",
     "maxTime": "PT90S",
     "any": [
      {
       "vision": "cw.sense.fragrant_no_browning"
      }
     ]
    },
    "onTimeout": "extend",
    "notes": {
     "en": "Garlic and paprika burn quickly; do not exceed 90 s."
    },
    "hazards": [
     "hz_oil"
    ],
    "attention": "continuous",
    "space": {
     "zone": "hob",
     "keepClearOfChildren": true
    }
   },
   {
    "id": "n7",
    "op": "cw.op.simmer",
    "inputs": [
     "aromatic_base",
     "tomato",
     "salt",
     "blackpepper"
    ],
    "output": "sauce",
    "params": {
     "heat": "medium_low",
