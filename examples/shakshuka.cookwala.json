      "seeds"
     ]
    },
    "hazards": [
     "hz_knife"
    ]
   },
   {
    "id": "n3",
    "op": "cw.op.cut",
    "inputs": [
     "garlic"
    ],
    "output": "garlic_minced",
    "equipment": [
     "knife",
     "board"
    ],
    "params": {
