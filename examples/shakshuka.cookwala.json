    ],
    "output": "sauce_with_wells",
    "params": {
     "count": 6,
     "spacing": "even"
    },
    "timing": {
     "nextWithin": "PT2M"
    }
   },
   {
    "id": "n10",
    "op": "cw.op.crack",
