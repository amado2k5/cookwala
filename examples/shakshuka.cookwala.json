    "post": [
     {
      "of": "veg_soft",
      "state": "translucent",
      "checks": [
       {
        "vision": "cw.sense.translucent"
       }
      ]
     }
    ],
    "pause": {
     "pausable": true,
     "safeState": [
      "heat_off",
      "move_from_edge"
     ],
     "maxPause": "PT20M",
     "onExceeded": "reheat_then_resume"
    },
    "failureModes": [
     {
      "incident": "cw.incident.scorched_bottom",
      "likelihood": "medium",
      "detect": [
       {
        "vision": "cw.sense.dark_edges"
       }
      ],
      "prevent": [
