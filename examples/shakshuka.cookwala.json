 "text": {
  "en": {
   "title": "Shakshuka",
   "intro": "Eggs poached in a spiced tomato and pepper sauce, cooked in one pan.",
   "steps": {
    "n5": "Cook the onion and pepper in the hot oil, stirring now and then, until soft and translucent.",
    "n6": "Add garlic, cumin and paprika; stir for about a minute until fragrant.",
    "n7": "Add tomatoes, salt and pepper; simmer uncovered until thickened.",
    "n11": "Crack an egg into each well, cover, and cook on low until the whites are set."
   }
  },
  "ar": {
   "title": "شكشوكة",
   "intro": "بيض مطهو في صلصة طماطم وفلفل متبلة، في مقلاة واحدة."
  }
 },
