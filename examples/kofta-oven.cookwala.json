 },
 "text": {
  "en": {
   "title": "Oven-baked beef kofta",
   "intro": "Spiced ground-beef fingers baked instead of grilled: a weeknight kofta with a measurable finish, 71 °C at the centre.",
   "steps": {
    "n1": "Grate the onion finely and squeeze out the juice.",
    "n2": "Chop the parsley finely.",
    "n3": "Crush the garlic.",
    "n4": "Mix the beef with the onion, parsley, garlic and spices until even. Wash everything that touched raw meat.",
    "n5": "Shape into 12 fingers of about 70 g each.",
    "n6": "Chill for 20 minutes so they hold their shape (no more than 2 hours).",
    "n7": "Preheat the oven to 220 °C with the oiled tray inside.",
    "n8": "Bake on the middle rack until the thickest piece reads 71 °C at the centre (14 to 22 minutes).",
    "n9": "Rest 3 minutes, covered.",
    "n10": "Serve hot with rice, salad and tahini."
   }
  },
  "ar": {
   "title": "كفتة لحم في الفرن",
   "intro": "أصابع كفتة لحم متبلة تُخبز في الفرن بدل الشواء: كفتة أيام الأسبوع مع نهاية قابلة للقياس، 71 درجة في المركز.",
   "steps": {
    "n1": "ابشري البصل ناعمًا واعصري ماءه.",
    "n2": "افرمي البقدونس ناعمًا.",
    "n3": "اهرسي الثوم.",
    "n4": "اخلطي اللحم مع البصل والبقدونس والثوم والبهارات حتى يتجانس. اغسلي كل ما لمس اللحم النيء.",
    "n5": "شكّلي 12 أصبعًا بوزن 70 جم تقريبًا.",
    "n6": "ضعيها في الثلاجة 20 دقيقة لتثبت (لا تتجاوز ساعتين).",
    "n7": "سخّني الفرن إلى 220 درجة مع الصاج المدهون بداخله.",
    "n8": "اخبزيها على الرف الأوسط حتى يصل مركز أكبر قطعة إلى 71 درجة (14 إلى 22 دقيقة).",
    "n9": "اتركيها 3 دقائق مغطاة.",
    "n10": "قدّميها ساخنة مع الأرز والسلطة والطحينة."
   }
  }
 },
