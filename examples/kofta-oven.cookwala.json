 ],
 "equipment": [
  {
   "ref": "oven",
   "class": "cw.eq.heat.oven",
   "constraints": {
    "maxTempC": 250
   }
  },
  {
   "ref": "tray",
   "class": "cw.eq.vessel.tray.baking"
  },
  {
   "ref": "grater",
   "class": "cw.eq.tool.grater"
  },
  {
   "ref": "knife",
   "class": "cw.eq.tool.knife.chef"
  },
  {
   "ref": "board",
   "class": "cw.eq.tool.cutting_board"
  },
  {
   "ref": "bowl",
   "class": "cw.eq.tool.bowl.mixing"
  },
  {
   "ref": "probe",
   "class": "cw.eq.sensor.probe"
  },
  {
   "ref": "fridge",
   "class": "cw.eq.cold.fridge"
  }
 ],
 "process": {
  "nodes": [
   {
    "id": "n1",
    "op": "cw.op.grate",
    "inputs": [
     "onion"
    ],
    "output": "onion_grated",
    "equipment": [
     "grater"
    ],
    "params": {
     "fineness": "fine"
    },
    "hazards": [
     "hz_knife"
    ]
   },
   {
    "id": "n2",
    "op": "cw.op.cut",
    "inputs": [
     "parsley"
    ],
    "output": "parsley_chopped",
    "equipment": [
     "knife",
     "board"
    ],
    "params": {
     "shape": "mince"
    },
    "hazards": [
     "hz_knife"
    ]
   },
   {
    "id": "n3",
    "op": "cw.op.crush",
    "inputs": [
     "garlic"
    ],
    "output": "garlic_paste",
    "params": {
     "texture": "paste"
    }
   },
   {
    "id": "n4",
    "op": "cw.op.mix",
    "inputs": [
     "beef",
     "onion_grated",
     "parsley_chopped",
     "garlic_paste",
     "salt",
     "pepper",
     "cumin",
     "allspice"
    ],
    "output": "kofta_mix",
    "equipment": [
     "bowl"
    ],
    "params": {
     "speed": "normal",
     "untilEven": true
    },
    "hazards": [
     "hz_raw_meat"
    ],
    "notes": {
     "en": "Squeeze excess juice from the grated onion first. Wash hands, tools and grippers after touching raw meat."
    }
   },
   {
    "id": "n5",
    "op": "cw.op.form",
    "inputs": [
     "kofta_mix"
    ],
    "output": "kofta_shaped",
    "params": {
     "shape": "finger",
     "count": 12,
     "massG": 70
    },
    "hazards": [
     "hz_raw_meat"
    ]
   },
   {
    "id": "n6",
    "op": "cw.op.chill",
    "inputs": [
     "kofta_shaped"
    ],
    "output": "kofta_chilled",
    "equipment": [
     "fridge"
    ],
    "params": {
     "tempC": 4
    },
    "until": {
     "minTime": "PT20M",
     "maxTime": "PT2H"
    },
    "onTimeout": "extend",
    "ccp": "ccp_raw_hold"
   },
   {
    "id": "n7",
    "op": "cw.op.heat",
    "inputs": [
     "oil"
    ],
    "output": "tray_oiled",
    "equipment": [
     "oven",
     "tray"
    ],
    "params": {
     "heat": "high",
     "tempC": 220,
     "target": {
      "sensor": "cw.sense.oven_temp",
      "value": 220,
      "unit": "degC",
      "tolerance": 10
     }
    },
    "until": {
     "all": [
      {
       "sensor": "cw.sense.oven_temp",
       "gte": 210
      }
     ],
     "minTime": "PT8M",
     "maxTime": "PT20M"
    },
    "onTimeout": "extend",
    "hazards": [
     "hz_oven"
    ],
    "attention": "none",
    "notes": {
     "en": "Preheat the oven to 220 °C with the oiled tray inside."
    }
   },
   {
    "id": "n8",
    "op": "cw.op.bake",
    "inputs": [
     "kofta_chilled",
     "tray_oiled"
    ],
    "output": "kofta_baked",
    "equipment": [
     "oven",
     "tray"
    ],
    "params": {
     "heat": "high",
     "tempC": 220,
     "ovenMode": "conventional",
     "rack": "middle",
     "target": {
      "sensor": "cw.sense.oven_temp",
      "value": 220,
      "unit": "degC",
      "tolerance": 10
     }
    },
    "until": {
     "all": [
      {
       "sensor": "cw.sense.core_temp",
       "target": "kofta_chilled",
       "gte": 71
      }
     ],
     "minTime": "PT14M",
     "maxTime": "PT22M"
    },
    "onTimeout": "extend",
    "ccp": "ccp_ground_meat",
    "hazards": [
     "hz_oven"
    ],
    "attention": "periodic"
   },
   {
    "id": "n9",
    "op": "cw.op.rest",
    "inputs": [
     "kofta_baked"
    ],
    "output": "kofta_rested",
    "params": {
     "cover": true
    },
    "until": {
     "minTime": "PT3M",
     "maxTime": "PT6M"
    },
    "onTimeout": "extend"
   },
   {
    "id": "n10",
    "op": "cw.op.serve",
    "inputs": [
     "kofta_rested"
    ],
    "params": {
     "serveWithin": "PT30M",
     "keepHot": {
      "gte": 60,
      "unit": "degC"
     }
    }
   }
  ],
  "edges": "implicit-from-inputs",
  "parallelGroups": [
   [
    "n1",
    "n2",
    "n3"
   ]
  ]
 },
 "safety": {
  "hazards": [
   {
    "id": "hz_knife",
    "type": "cw.hz.cut.knife",
    "severity": "medium",
    "mitigation": [
     "keep_human_clear_of_blade",
     "stable_board"
    ]
   },
   {
    "id": "hz_raw_meat",
    "type": "cw.hz.pathogen.raw_meat",
    "severity": "high",
    "mitigation": [
     "dedicated_board",
     "wash_tools_and_grippers_after_contact",
     "no_cross_contact_with_ready_food"
    ]
   },
   {
    "id": "hz_oven",
    "type": "cw.hz.burn.hot_surface",
    "severity": "medium",
    "mitigation": [
     "oven_mitts_or_heat_rated_gripper",
     "open_door_slowly"
    ]
   }
  ],
  "ccps": [
   {
    "id": "ccp_raw_hold",
    "hazard": "pathogen.raw_meat",
    "node": "n6",
    "criticalLimit": "raw mixture kept at or below 5 °C and for at most 2 h before baking",
    "monitoring": [
     "cw.sense.fridge_temp",
     "time"
    ],
    "corrective": "bake now, or discard if above 5 °C for more than 2 h"
   },
   {
    "id": "ccp_ground_meat",
    "hazard": "pathogen.e_coli_salmonella",
    "node": "n8",
    "criticalLimit": "core temperature of every piece at or above 71 °C",
    "limit": {
     "sensor": "cw.sense.core_temp",
     "gte": 71
    },
    "monitoring": [
     "cw.sense.core_temp"
    ],
    "corrective": "return to the oven and re-probe the thickest piece; never serve below 71 °C"
   }
  ],
  "allergens": {
   "eu14": [],
   "us9": [],
   "mayContain": []
  },
  "dietary": [
   {
