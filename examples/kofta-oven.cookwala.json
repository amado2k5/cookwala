    "ar": "1½ ملعقة صغيرة كمون"
   },
   "scaling": "sublinear"
  },
  {
   "ref": "allspice",
   "ingredientId": "cw.ing.allspice_ground",
   "qty": {
    "value": 1,
    "unit": "g",
    "tolerance": 0.5
   },
   "display": {
