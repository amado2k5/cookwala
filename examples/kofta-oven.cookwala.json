   },
   {
    "claim": "gluten_free",
    "basis": "ingredients"
   },
   {
    "claim": "dairy_free",
    "basis": "ingredients"
   }
  ],
  "supervision": {
   "default": "unattended_ok",
   "reasons": {
    "n1": "grater",
    "n2": "knife",
    "n4": "raw meat hygiene",
    "n7": "hot oven"
   }
  },
  "abort": {
   "steps": [
    "heat_off",
    "alert_user"
   ],
   "neverLeave": []
  }
 },
