   },
   "scaling": "sublinear"
  },
  {
   "ref": "pepper",
   "ingredientId": "cw.ing.black_pepper_ground",
   "qty": {
    "value": 2,
    "unit": "g",
    "tolerance": 0.4
   },
   "display": {
    "en": "1 tsp black pepper",
