     "oven",
     "tray"
    ],
    "params": {
     "heat": "medium_high",
     "tempC": 180,
     "ovenMode": "conventional",
     "rack": "middle",
     "target": {
      "sensor": "cw.sense.oven_temp",
      "value": 180,
      "unit": "degC",
      "tolerance": 10
     }
    },
    "until": {
     "all": [
      {
       "vision": "cw.sense.color_golden_brown",
       "target": "batter_rested"
      }
     ],
     "any": [
      {
       "sensor": "cw.sense.core_temp",
       "target": "batter_rested",
       "gte": 95,
       "optional": true
      }
     ],
     "minTime": "PT30M",
     "maxTime": "PT42M"
    },
    "onTimeout": "extend",
    "hazards": [
