 "text": {
  "en": {
   "title": "Basbousa",
   "intro": "Semolina cake soaked in lemon syrup, cut in diamonds with an almond on each: the dessert of every Egyptian gathering.",
   "steps": {
    "n1": "Melt the ghee gently.",
    "n2": "Mix the semolina, sugar, coconut and baking powder.",
    "n3": "Stir in the yogurt and melted ghee until just combined.",
    "n4": "Grease the tray with tahini, spread the batter 2 cm thick, score diamonds and press an almond on each.",
    "n5": "Rest 10 to 20 minutes.",
    "n6": "Preheat the oven to 180 °C.",
    "n7": "Bake on the middle rack until deep golden (30 to 42 minutes).",
    "n8": "Meanwhile bring the sugar and water to the boil, stirring only until the sugar dissolves.",
    "n9": "Add the lemon juice and boil 4 to 7 minutes to a thin syrup. Do not let it caramelize.",
    "n10": "Pour the hot syrup over the cake as soon as it comes out of the oven.",
    "n11": "Cool until barely warm (30 to 90 minutes).",
    "n12": "Cut along the scored diamonds.",
    "n13": "Serve at room temperature."
   }
  },
  "ar": {
   "title": "بسبوسة",
   "intro": "كيك السميد المشرب بشربات الليمون، يُقطّع معينات وعلى كل واحدة لوزة: حلوى كل مناسبة مصرية.",
   "steps": {
    "n1": "ذوّبي السمن على نار هادئة.",
    "n2": "اخلطي السميد والسكر وجوز الهند والبيكنج بودر.",
    "n3": "أضيفي الزبادي والسمن المذاب وقلّبي حتى يتجانس فقط.",
    "n4": "ادهني الصاج بالطحينة، وافردي الخليط بسماكة 2 سم، وخططيه معينات وضعي حبة لوز على كل منها.",
    "n5": "اتركيه من 10 إلى 20 دقيقة.",
    "n6": "سخّني الفرن إلى 180 درجة.",
    "n7": "اخبزيه على الرف الأوسط حتى يصبح ذهبيًا داكنًا (30 إلى 42 دقيقة).",
    "n8": "في الوقت نفسه اتركي السكر والماء يغليان مع التقليب حتى يذوب السكر فقط.",
    "n9": "أضيفي عصير الليمون واتركيه يغلي 4 إلى 7 دقائق حتى يصبح شربات خفيفًا. لا تتركيه يتكرمل.",
    "n10": "اسكبي الشربات الساخن على البسبوسة فور خروجها من الفرن.",
    "n11": "اتركيها حتى تبرد (30 إلى 90 دقيقة).",
    "n12": "قطّعيها على خطوط المعينات.",
    "n13": "قدّميها بحرارة الغرفة."
   }
  }
 },
