<?xml version="1.0" encoding="utf-8"?>
<!-- choco pack samples/build/manifests/chocolatey/cookwala-samples.nuspec ; choco push cookwala-samples.{{VERSION}}.nupkg -s https://push.chocolatey.org/ -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>cookwala-samples</id>
    <version>{{VERSION}}</version>
    <title>Cookwala samples</title>
    <authors>Cookwala maintainers</authors>
    <owners>amado2k5</owners>
    <projectUrl>https://cookwala.ai</projectUrl>
    <projectSourceUrl>https://github.com/amado2k5/cookwala/tree/main/samples</projectSourceUrl>
    <packageSourceUrl>https://github.com/amado2k5/cookwala/tree/main/samples/packaging/chocolatey</packageSourceUrl>
    <iconUrl>https://cookwala.ai/assets/icon.svg</iconUrl>
    <releaseNotes>https://github.com/amado2k5/cookwala/releases/tag/samples-v{{VERSION}}</releaseNotes>
    <licenseUrl>https://github.com/amado2k5/cookwala/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>cookwala cooking robots food-safety agents orchestration samples cli</tags>
    <summary>Cookwala sample clients, agents, orchestrators, gates, recovery and reporting.</summary>
    <description>Runnable samples for the Cookwala Core 0.2 API, the open standard for cooking safely. Runs offline on simulated devices (`cookwala-samples demo`) or against any Cookwala hub. Samples, not certified software; the executor is always the authority.</description>
    <dependencies>
      <dependency id="python3" version="3.9.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
