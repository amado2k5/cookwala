# conda-forge staged-recipes: recipes/cookwala-samples/meta.yaml (built from the PyPI sdist)
{% set version = "{{VERSION}}" %}

package:
  name: cookwala-samples
  version: {{ version }}

source:
  url: https://pypi.org/packages/source/c/cookwala-samples/cookwala_samples-{{ version }}.tar.gz
  sha256: {{SHA256:sdist}}

build:
  noarch: python
  number: 0
  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation
  entry_points:
    - cookwala-samples = cookwala_samples.cli:main

requirements:
  host:
    - python >=3.9
    - pip
    - setuptools >=68
  run:
    - python >=3.9

test:
  imports:
    - cookwala_samples
  commands:
    - cookwala-samples version
    - cookwala-samples demo

about:
  home: https://cookwala.ai
  summary: Cookwala sample clients, agents, orchestrators, gates, recovery and reporting
  license: Apache-2.0
  license_file: LICENSE
  dev_url: https://github.com/amado2k5/cookwala

extra:
  recipe-maintainers:
    - amado2k5
