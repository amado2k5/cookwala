<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org is the only package source for building and testing the samples.
     Publishers add Artifactory or GitHub Packages at release time; see README.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
