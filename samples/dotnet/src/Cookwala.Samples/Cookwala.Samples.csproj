<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cookwala samples for .NET 8: clients, agents, orchestrators, gates, recovery and reporting for the
       Core 0.2 API. No dependencies beyond the BCL (System.Text.Json, HttpClient, HttpListener). -->
  <PropertyGroup>
    <RootNamespace>Cookwala.Samples</RootNamespace>
    <AssemblyName>Cookwala.Samples</AssemblyName>
    <PackageId>Cookwala.Samples</PackageId>
    <Description>Cookwala sample clients, agents, orchestrators, gates, recovery and reporting for the Core 0.2 API; runs offline on simulated devices or against any Cookwala hub. Samples, not certified software.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared bundle (generated by samples/tools/build_bundle.py) is embedded, never copied. -->
    <EmbeddedResource Include="../../../data/bundle.json" LogicalName="Cookwala.Samples.bundle.json" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
